{
  "identifier": "deploy_port_k8s_helm",
  "title": "Deploy Port integration for k8s",
  "icon": "Deployment",
  "description": "Deploy Port's k8s integration via Helm",
  "trigger": {
    "type": "self-service",
    "operation": "CREATE",
    "userInputs": {
      "properties": {
        "cluster": {
          "icon": "DefaultProperty",
          "title": "EKS Cluster",
          "description": "Select the EKS cluster for deployment",
          "type": "string",
          "blueprint": "eksCluster",
          "format": "entity"
        }
      },
      "required": [],
      "order": []
    }
  },
  "invocationMethod": {
    "type": "GITHUB",
    "org": "Porterview",
    "repo": "port-integration-k8s",
    "workflow": "deploy-helm.yaml",
    "workflowInputs": {
      "ref": "main",
      "cluster": "{{ .inputs.cluster.identifier }}",
      "port_context": {
        "entity": "{{ .entity }}",
        "blueprint": "{{ .action.blueprint }}",
        "runId": "{{ .run.id }}",
        "trigger": "{{ .trigger }}"
      }
    },
    "reportWorkflowStatus": true
  },
  "requiredApproval": false
}
