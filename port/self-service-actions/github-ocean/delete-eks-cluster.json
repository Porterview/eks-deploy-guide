{
  "identifier": "eks_delete_eks_cluster",
  "title": "Delete EKS cluster",
  "icon": "AmazonEKS",
  "description": "An action that deletes an eks cluster",
  "trigger": {
    "type": "self-service",
    "operation": "DELETE",
    "userInputs": {
      "properties": {
        "region": {
          "icon": "DefaultProperty",
          "title": "Region",
          "type": "string",
          "blueprint": "region",
          "format": "entity"
        }
      },
      "required": [
        "region"
      ],
      "order": [
        "region"
      ]
    },
    "blueprintIdentifier": "eksCluster"
  },
  "invocationMethod": {
    "type": "INTEGRATION_ACTION",
    "installationId": "gh-ocean",
    "integrationActionType": "dispatch_workflow",
    "integrationActionExecutionProperties": {
      "org": "Porterview",
      "repo": "eks-deploy-guide",
      "workflow": "manage-eks-cluster.yml",
      "workflowInputs": {
        "cluster_name": "{{.entity.properties.name}}",
        "region": "{{ .inputs.\"region\".identifier }}",
        "action": "destroy",
        "port_context": "{\"entity\": {{ .entity | toJson }}, \"blueprint\": \"{{ .action.blueprint }}\", \"runId\": \"{{ .run.id }}\", \"trigger\": {{ .trigger | toJson }}}"
      },
      "reportWorkflowStatus": true
    }
  },
  "requiredApproval": {
    "type": "ANY"
  },
  "approvalNotification": {
    "type": "email"
  },
  "allowAnyoneToViewRuns": true
}
